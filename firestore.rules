rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Session Q&A — Firestore security rules
//
// SECURITY MODEL (read before editing):
// The web client talks to Firestore directly using the public web config and
// has NO Firebase Auth token. Rules therefore CANNOT tell an instructor apart
// from an anonymous attacker for writes. Access to the instructor *dashboard*
// is gated separately by the Next.js OAuth layer (@salesforce.com only), but
// that gate does not attach an identity to Firestore writes.
//
// What these rules do today (defense-in-depth against abuse/cost, not identity):
//   - Validate shape + size on public creates (questions, sessions, feedback)
//     so nobody can write oversized/cost-inflating or malformed documents.
//   - Force new questions into a clean initial state (no pre-pinned / pre-voted
//     / pre-answered injection).
//   - Forbid destructive deletes where the app never needs them.
//
// PHASE 2 — TRUE WRITE LOCKDOWN (follow-up, requires a service account):
//   Route every instructor mutation (create/update session, delete/pin/answer
//   question, manage instructors) through authenticated Next.js API routes using
//   the Firebase Admin SDK (which bypasses these rules). Then flip client writes
//   on instructor-only paths to `if false`. Until that proxy exists, locking
//   these paths here would break the live app.
//
// DEPLOY: changes here are NOT live until you run
//   firebase deploy --only firestore:rules
// Review carefully first — this app is in active production use.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Instructor accounts (display name + hashed PIN). Also written by the
    // co-instructor "join" flow via set(merge) → keep create/update permissive
    // until instructor writes move server-side (Phase 2). Never client-deletable.
    match /instructors/{instructorId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Sessions (instructor creates/updates session info) and questions
    match /sessions/{sessionId} {
      allow read: if true;
      // Validate the one required field + cap sizes on create; updates stay open
      // (many partial updates: settings, notes, arrays) pending the Phase 2 proxy.
      allow create: if request.resource.data.sessionName is string
        && request.resource.data.sessionName.size() > 0
        && request.resource.data.sessionName.size() <= 300;
      allow update: if true;
      allow delete: if false;

      match /questions/{questionId} {
        allow read: if true;
        // New questions must arrive in a clean initial state with capped sizes.
        allow create: if request.resource.data.keys().hasAll(
              ['text', 'authorName', 'authorId', 'createdAt', 'status', 'pinned', 'votes', 'voters']
            )
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 10000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 200
          && request.resource.data.authorId is string
          && request.resource.data.authorId.size() <= 200
          && request.resource.data.status == 'pending'
          && request.resource.data.pinned == false
          && request.resource.data.votes == 0
          && request.resource.data.voters is list
          && request.resource.data.voters.size() == 0;
        // Updates keep authorId unchanged (votes, answers, status, student text edits).
        allow update: if resource.data.authorId == request.resource.data.authorId;
        // Instructors delete from the dashboard; without Firebase Auth this cannot
        // be restricted to "only instructors" until the Phase 2 server proxy exists.
        allow delete: if true;
      }
      // Anonymous student dashboard feedback per session (path implies session; no email stored).
      match /sessionFeedback/{docId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['subject', 'body', 'submittedAtMs'])
          && request.resource.data.size() == 3
          && request.resource.data.subject is string
          && request.resource.data.body is string
          && (
            request.resource.data.submittedAtMs is int
            || (
              request.resource.data.submittedAtMs is float
              && int(request.resource.data.submittedAtMs) == request.resource.data.submittedAtMs
            )
          )
          && request.resource.data.submittedAtMs >= 946684800000
          && request.resource.data.submittedAtMs <= 4102444800000
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 500
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 12000;
        allow update, delete: if false;
      }
    }
  }
}
