# ── Google OAuth ────────────────────────────────────────────────────────────
# Create a project at console.cloud.google.com, enable "Google Identity" API,
# then create an OAuth 2.0 Web client credential.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# ── Session encryption ───────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-at-least-32-random-chars

# ── Domain restriction ───────────────────────────────────────────────────────
# Only users whose Google account matches this hosted domain may sign in.
ALLOWED_DOMAIN=salesforce.com
# Also exposed to client components for display purposes only:
NEXT_PUBLIC_ALLOWED_DOMAIN=salesforce.com

# ── App URL ──────────────────────────────────────────────────────────────────
# The base URL where this Next.js app is served.
# For local dev: http://localhost:3000
# For Vercel prod: https://your-app.vercel.app
APP_URL=http://localhost:3000

# ── Vite app origin (Phase 1 iframe integration) ─────────────────────────────
# Where the existing Vite app is running (in Phase 1 iframe mode).
# For local dev run `npm run dev` in the root repo (defaults to :5173).
# On Vercel Phase 2 this can be removed once content is fully inline.
VITE_APP_ORIGIN=http://localhost:5173

# ── Firebase (passed through to the Vite app — not used by Next.js directly) ─
# These are already configured in src/config/firebase.js of the Vite app.
# No action needed here unless you want to override them for this Next layer.
